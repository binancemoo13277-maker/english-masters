{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"}
      ]
    }
  ]
}
